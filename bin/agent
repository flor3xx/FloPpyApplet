#!/usr/bin/env bash
set -u

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/opencode-agent-dashboard"
PIDFILE="$DATA/daemon.pid"
LOCKFILE="$DATA/daemon.lock"
LOGFILE="$DATA/daemon.log"
TOKENFILE="$DATA/daemon.token"
PLUGIN_SOURCE="$ROOT/plugin/agent-plugin.js"
PLUGIN_TARGET="$HOME/.config/opencode/plugins/agent-plugin.js"
PORT="${AGENT_PORT:-47321}"

mkdir -p "$DATA" "$HOME/.config/opencode/plugins" 2>/dev/null || true
if [ ! -s "$TOKENFILE" ]; then
  (umask 077; python3 -c 'import secrets; print(secrets.token_urlsafe(32))' >"$TOKENFILE") 2>/dev/null || true
fi

running() {
  [ -r "$PIDFILE" ] || return 1
  local pid
  pid="$(<"$PIDFILE")"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

daemon_command() {
  if [ -f "$ROOT/daemon/server.py" ]; then
    printf '%s\n' "$ROOT/daemon/server.py"
  else
    return 1
  fi
}

open_applet() {
  # L'applet installato può registrare questa interfaccia D-Bus per aprire il popup.
  if command -v gdbus >/dev/null 2>&1; then
    gdbus call --session --dest org.Cinnamon --object-path /org/Cinnamon \
      --method org.Cinnamon.OpenAppletPopup "flo-agent@florexx" >/dev/null 2>&1 && return 0
  fi
  return 1
}

start() {
  if running; then
    open_applet || true
    return 0
  fi
  rm -f "$PIDFILE"
  if ! command -v flock >/dev/null 2>&1; then
    printf '%s\n' "Errore: serve flock per garantire una sola istanza." >&2
    return 1
  fi
  exec 9>"$LOCKFILE"
  flock -n 9 || return 0
  if running; then return 0; fi
  local server
  server="$(daemon_command 2>/dev/null || true)"
  if [ -z "$server" ]; then
    printf '%s\n' "Daemon non ancora presente: impossibile avviare la dashboard." >&2
    return 1
  fi
  # Avvia come modulo: server.py usa import relativi quando viene eseguito dal package.
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" nohup python3 -m daemon.server \
    --host 127.0.0.1 --port "$PORT" >>"$LOGFILE" 2>&1 &
  printf '%s\n' "$!" >"$PIDFILE"
  sleep 0.15
  open_applet || printf '%s\n' "Daemon avviato; applet non disponibile o non installato." >&2
}

stop() {
  if ! running; then rm -f "$PIDFILE"; printf '%s\n' "Daemon non attivo."; return 0; fi
  local pid
  pid="$(<"$PIDFILE")"
  kill "$pid" 2>/dev/null || true
  for _ in 1 2 3 4 5; do running || break; sleep 0.2; done
  running && kill -KILL "$pid" 2>/dev/null || true
  rm -f "$PIDFILE"
  printf '%s\n' "Daemon fermato."
}

status() {
  if running; then
    printf 'Daemon attivo (PID %s)\n' "$(<"$PIDFILE")"
  else
    rm -f "$PIDFILE"
    printf '%s\n' "Daemon non attivo."
    return 1
  fi
}

logs() { touch "$LOGFILE" 2>/dev/null || true; tail -n "${AGENT_LOG_LINES:-80}" "$LOGFILE"; }

install_plugin() {
  [ -f "$PLUGIN_SOURCE" ] || { printf '%s\n' "Plugin sorgente mancante." >&2; return 1; }
  if [ -f "$PLUGIN_TARGET" ] && cmp -s "$PLUGIN_SOURCE" "$PLUGIN_TARGET"; then
    printf '%s\n' "Plugin già aggiornato."
    return 0
  fi
  if [ -f "$PLUGIN_TARGET" ]; then
    cp -p "$PLUGIN_TARGET" "$PLUGIN_TARGET.bak-$(date +%Y%m%d-%H%M%S)" || return 1
  fi
  install -m 0644 "$PLUGIN_SOURCE" "$PLUGIN_TARGET"
  printf 'Plugin installato in %s\n' "$PLUGIN_TARGET"
}

uninstall_plugin() {
  if [ -f "$PLUGIN_TARGET" ] && cmp -s "$PLUGIN_SOURCE" "$PLUGIN_TARGET"; then
    rm -f "$PLUGIN_TARGET"
    printf '%s\n' "Plugin rimosso."
  else
    printf '%s\n' "Plugin non rimosso: il file non coincide con quello installato da agent."
  fi
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  status) status ;;
  logs) logs ;;
  install-plugin) install_plugin ;;
  uninstall-plugin) uninstall_plugin ;;
  *) printf 'Uso: agent [start|stop|status|logs|install-plugin|uninstall-plugin]\n' >&2; exit 2 ;;
esac
